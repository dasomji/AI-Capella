DATABASE_URL=postgres://lightscore:local-only@127.0.0.1:25432/lightscore
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://127.0.0.1:21025
RESEND_API_KEY=
MAIL_FROM=LightScore <noreply@localhost.test>
S3_ENDPOINT=http://127.0.0.1:28333
S3_REGION=us-east-1
S3_BUCKET=lightscore
S3_ACCESS_KEY_ID=local-only
S3_SECRET_ACCESS_KEY=local-only
OPENAI_API_KEY=
APP_TIME_ZONE=UTC

# Trust only headers overwritten by your ingress; see docs/DEVELOPMENT.md.
AUTH_IP_HEADERS=
AUTH_TRUSTED_PROXIES=

# Maximum uncompressed score body size (20 MiB).
SCORE_MAX_BYTES=20971520
# Admission covers body read, validation and persistence; excess requests are not queued.
SCORE_UPLOAD_GLOBAL_MAX=4
SCORE_UPLOAD_USER_MAX=1

DB_POOL_MAX=10
INVITE_ENSEMBLE_DAILY_MAX=50
INVITE_USER_DAILY_MAX=100
ENSEMBLE_USER_DAILY_MAX=10
DOMAIN_USER_MINUTE_MAX=120

# Authoritative playback effective-time lead (milliseconds).
PLAYBACK_LEAD_MS=400
