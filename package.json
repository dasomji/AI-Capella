{
  "name": "ai-capella",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx ./node_modules/vite/bin/vite.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/entry.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit.test.ts tests/rehearsal.test.ts tests/rehearsal-server.test.ts",
    "test:integration": "node scripts/integration.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "accounts:cleanup": "node --env-file-if-exists=.env --import tsx scripts/cleanup-accounts.ts",
    "test:browser": "node scripts/browser-isolated.mjs",
    "test:browser:foundation": "node scripts/browser-smoke.mjs",
    "test:browser:sync": "BROWSER_SCRIPT=scripts/browser-sync-acceptance.mjs node scripts/browser-isolated.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "drizzle-kit": "^0.31.11",
    "playwright": "^1.64.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource/italianno": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "better-auth": "^1.7.15",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.12.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "jsdom": "^30.1.3",
    "jspdf": "^4.2.1",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.37.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "svg2pdf.js": "^2.8.1",
    "tsx": "^4.23.15",
    "verovio": "^6.3.0",
    "zod": "^4.6.7"
  }
}
