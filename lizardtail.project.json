{
  "version": 1,
  "project": "lightscore",
  "env": {
    "NODE_ENV": "development",
    "PORT": "${port.web}",
    "LIZARDTAIL_ORIGIN": "${origin.app}",
    "BETTER_AUTH_URL": "${origin.app}",
    "TRUSTED_ORIGINS": "${origin.app}",
    "BETTER_AUTH_SECRET": "${storage.secretKey}",
    "AUTH_IP_HEADERS": "",
    "AUTH_TRUSTED_PROXIES": "",
    "MAIL_TRANSPORT": "smtp",
    "SMTP_SOCKET_PATH": "${HOME}/.local/state/aicap-preview/mail-${port.mail}/smtp.sock",
    "MAIL_FROM": "LightScore <noreply@localhost.test>",
    "S3_ENDPOINT": "${storage.internalEndpoint}",
    "S3_PUBLIC_ENDPOINT": "${origin.storage}",
    "S3_FORCE_PATH_STYLE": "true",
    "S3_REGION": "us-east-1",
    "S3_BUCKET": "${storage.bucket}",
    "S3_ACCESS_KEY_ID": "${storage.accessKey}",
    "S3_SECRET_ACCESS_KEY": "${storage.secretKey}",
    "APP_TIME_ZONE": "UTC",
    "TRANSCRIPTION_PROVIDER": "fake",
    "TRANSCRIPTION_EMERGENCY_STOP": "0",
    "OPENAI_API_KEY": "",
    "RESEND_API_KEY": ""
  },
  "database": {
    "kind": "postgres",
    "image": "postgres:17-alpine@sha256:266d3c257594e195b309ae9d1805e54c788f1d7b375f56bf6c367aac6c917e7b",
    "migrate": [
      "npm",
      "run",
      "db:migrate"
    ]
  },
  "storage": {
    "image": "chrislusf/seaweedfs:4.45@sha256:fc9f76fa993ad69966ffeb2f65d0318fcae39c6f8e20cf68ef7b3a5cb97769e5"
  },
  "services": {
    "mail": {
      "command": [
        "node",
        "scripts/preview-mail.mjs"
      ],
      "port": true,
      "env": {
        "PORT": "${port.mail}"
      },
      "ready": {
        "path": "/readyz",
        "timeoutMs": 30000
      }
    },
    "web": {
      "command": [
        "npm",
        "run",
        "dev",
        "--",
        "--host",
        "127.0.0.1",
        "--port",
        "${port.web}",
        "--strictPort"
      ],
      "port": true,
      "dependsOn": [
        "mail"
      ],
      "ready": {
        "path": "/healthz",
        "timeoutMs": 90000
      }
    },
    "worker": {
      "command": [
        "npm",
        "run",
        "worker"
      ],
      "dependsOn": [
        "web"
      ]
    }
  },
  "endpoints": {
    "app": {
      "routes": [
        {
          "path": "/",
          "service": "web"
        }
      ]
    },
    "mail": {
      "routes": [
        {
          "path": "/",
          "service": "mail"
        }
      ]
    },
    "storage": {
      "routes": [
        {
          "path": "/",
          "service": "storage"
        }
      ]
    }
  }
}
